# Dockerfile for local development - SELF-CONTAINED BUILD VERSION
# Copies all source code into image (except zephyr-sdk which is mounted at runtime)
# This allows complete builds inside the container
#
# Build context should be ZSG root directory

ARG BASE_IMAGE=ubuntu:20.04
FROM ${BASE_IMAGE}

ARG DEBIAN_FRONTEND=noninteractive
ARG USER_NAME=zephyr
ARG USER_UID=1000
ARG USER_GID=${USER_UID}
ARG WORKSPACE=/home/${USER_NAME}/zephyr_space
ARG ZEPHYR_SDK_VERSION=0.16.5
ARG CMAKE_VERSION=3.28.3
ARG CMAKE_ARCH=linux-x86_64

USER root

# Install all required packages including libusb for OpenOCD/serial debugging
RUN apt-get update && \
    apt-get install -y --no-install-recommends \
        ca-certificates \
        git \
        ninja-build \
        gperf \
        ccache \
        dfu-util \
        device-tree-compiler \
        wget \
        python3-dev \
        python3-pip \
        python3-setuptools \
        python3-tk \
        python3-wheel \
        python3-venv \
        xz-utils \
        file \
        make \
        gcc \
        gcc-multilib \
        g++-multilib \
        libsdl2-dev \
        libmagic1 \
        pkg-config \
        tar \
        unzip \
        bzip2 \
        locales \
        udev \
        libusb-1.0-0 \
        libusb-1.0-0-dev \
        libhidapi-hidraw0 \
        libhidapi-dev \
        libftdi1-2 \
        libftdi1-dev && \
    locale-gen en_US.UTF-8 && \
    update-ca-certificates && \
    # Install CMake
    CMAKE_MAJOR_MINOR=$(echo "${CMAKE_VERSION}" | cut -d. -f1,2) && \
    CMAKE_URL="https://cmake.org/files/v${CMAKE_MAJOR_MINOR}/cmake-${CMAKE_VERSION}-${CMAKE_ARCH}.tar.gz" && \
    echo "Downloading CMake from: ${CMAKE_URL}" && \
    wget --tries=3 --timeout=300 ${CMAKE_URL} -O /tmp/cmake.tar.gz && \
    tar -xzf /tmp/cmake.tar.gz -C /opt && \
    mv /opt/cmake-${CMAKE_VERSION}-${CMAKE_ARCH} /opt/cmake && \
    ln -sf /opt/cmake/bin/cmake /usr/local/bin/cmake && \
    ln -sf /opt/cmake/bin/ctest /usr/local/bin/ctest && \
    ln -sf /opt/cmake/bin/cpack /usr/local/bin/cpack && \
    rm -f /tmp/cmake.tar.gz && \
    rm -rf /opt/cmake/doc /opt/cmake/man && \
    apt-get clean && \
    rm -rf /var/lib/apt/lists/* /var/cache/apt/archives/* /tmp/* /var/tmp/*

# Install OpenOCD from build context
COPY --chown=root:root tools/openocd /usr/local/bin/openocd
RUN chmod +x /usr/local/bin/openocd

# Setup udev rules for common debuggers (runs as root)
RUN echo 'SUBSYSTEM=="usb", ATTR{idVendor}=="0d28", MODE="0666"' > /etc/udev/rules.d/99-cmsis-dap.rules && \
    echo 'SUBSYSTEM=="usb", ATTR{idVendor}=="0403", MODE="0666"' >> /etc/udev/rules.d/99-cmsis-dap.rules && \
    echo 'SUBSYSTEM=="usb", ATTR{idVendor}=="1a86", MODE="0666"' >> /etc/udev/rules.d/99-cmsis-dap.rules

# Set locale environment
ENV LANG=en_US.UTF-8 \
    LANGUAGE=en_US:en \
    LC_ALL=en_US.UTF-8

# Create user and workspace
RUN groupadd --gid ${USER_GID} ${USER_NAME} && \
    useradd --uid ${USER_UID} --gid ${USER_GID} --create-home --shell /bin/bash ${USER_NAME} && \
    mkdir -p ${WORKSPACE} && \
    chown -R ${USER_NAME}:${USER_NAME} /home/${USER_NAME} && \
    pip3 install --no-cache-dir west && \
    rm -rf /root/.cache/pip

# Set environment variables
# ZEPHYR_SDK_INSTALL_DIR will be set dynamically by entrypoint based on mounted SDK
ENV HOME=/home/${USER_NAME} \
    PATH=/usr/local/bin:/home/${USER_NAME}/.local/bin:$PATH \
    ZEPHYR_TOOLCHAIN_VARIANT=zephyr \
    WORKSPACE=${WORKSPACE} \
    ZEPHYR_SDK_VERSION=${ZEPHYR_SDK_VERSION}

# Switch to user for source code copy
USER ${USER_NAME}
WORKDIR ${WORKSPACE}

# Copy all source code EXCEPT zephyr-sdk into the image
# zephyr-sdk will be mounted at runtime to ${WORKSPACE}/zephyr-sdk-${ZEPHYR_SDK_VERSION}
COPY --chown=${USER_NAME}:${USER_NAME} bootloader ${WORKSPACE}/bootloader
COPY --chown=${USER_NAME}:${USER_NAME} modules ${WORKSPACE}/modules
COPY --chown=${USER_NAME}:${USER_NAME} sdk_env ${WORKSPACE}/sdk_env
COPY --chown=${USER_NAME}:${USER_NAME} sdk_glue ${WORKSPACE}/sdk_glue
COPY --chown=${USER_NAME}:${USER_NAME} zephyr ${WORKSPACE}/zephyr
COPY --chown=${USER_NAME}:${USER_NAME} tools ${WORKSPACE}/tools
COPY --chown=${USER_NAME}:${USER_NAME} docs ${WORKSPACE}/docs

# Initialize west workspace, install Python requirements, and register Zephyr commands
RUN cd ${WORKSPACE} && \
    west init -l sdk_glue && \
    west config manifest.file west_gitee.yml && \
    pip3 install --user --no-cache-dir -r zephyr/scripts/requirements.txt && \
    # CRITICAL: Run west zephyr-export to register 'west build', 'west flash', etc.
    west zephyr-export && \
    rm -rf /home/${USER_NAME}/.cache/pip

# Copy and setup entrypoint script
COPY --chown=${USER_NAME}:${USER_NAME} sdk_glue/docker-entrypoint.sh /home/${USER_NAME}/docker-entrypoint.sh
RUN chmod +x /home/${USER_NAME}/docker-entrypoint.sh

# Mark that source is embedded (for entrypoint detection)
RUN touch ${WORKSPACE}/.docker_embedded_source

ENTRYPOINT ["/home/zephyr/docker-entrypoint.sh"]
CMD ["/bin/bash"]

# =============================================================================
# USAGE:
# =============================================================================
#
# Build the image (use docker-build.sh script):
#   cd /path/to/ZSG/sdk_glue
#   ./docker-build.sh local
#
# Run with zephyr-sdk mounted to workspace (same level as sdk_glue):
#   docker run -it --rm \
#     -v /path/to/zephyr-sdk-0.16.5:/home/zephyr/zephyr_space/zephyr-sdk-0.16.5 \
#     --device=/dev/ttyUSB0 \
#     zephyr_hpmicro:local
#
# Or use docker-compose (recommended):
#   docker-compose --profile local up -d zephyr-local
#   docker-compose --profile local exec zephyr-local /bin/bash
#
# Build a Zephyr project inside container:
#   west build -b hpm6750evkmini samples/basic/blinky
#
# Flash to target:
#   west flash
#
# The entrypoint script will automatically:
# 1. Detect the mounted zephyr-sdk
# 2. Run setup.sh to register CMake package
# 3. Set ZEPHYR_SDK_INSTALL_DIR environment variable
# =============================================================================
