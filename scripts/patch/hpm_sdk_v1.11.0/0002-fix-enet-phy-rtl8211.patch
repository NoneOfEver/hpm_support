From faf2af223f2c8f97b0eaf90927b44d94560add48 Mon Sep 17 00:00:00 2001
From: Yingda WU <yingda.wu@hpmicro.com>
Date: Wed, 31 Dec 2025 14:04:37 +0800
Subject: [PATCH] [fix]: enet phy rtl8211

Signed-off-by: Yingda WU <yingda.wu@hpmicro.com>
---
 hpm_sdk/components/enet_phy/rtl8211/hpm_rtl8211.c | 4 ++--
 1 file changed, 2 insertions(+), 2 deletions(-)

diff --git a/hpm_sdk/components/enet_phy/rtl8211/hpm_rtl8211.c b/hpm_sdk/components/enet_phy/rtl8211/hpm_rtl8211.c
index 175df1037..6c55fe5d6 100644
--- a/hpm_sdk/components/enet_phy/rtl8211/hpm_rtl8211.c
+++ b/hpm_sdk/components/enet_phy/rtl8211/hpm_rtl8211.c
@@ -82,13 +82,13 @@ bool rtl8211_basic_mode_init(ENET_Type *ptr, uint32_t phy_addr, rtl8211_config_t
         data |= RTL8211_BMCR_DUPLEX_SET(config->duplex);                                                /* Set duplex mode */
     }
 
+    enet_write_phy(ptr, phy_addr, RTL8211_BMCR, data);
+
     /* check the id of rtl8211 */
     if (rtl8211_check_id(ptr, phy_addr) == false) {
         return false;
     }
 
-    enet_write_phy(ptr, phy_addr, RTL8211_BMCR, data);
-
     return true;
 }
 
