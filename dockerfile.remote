# Support incremental build: use existing image as base if BASE_IMAGE is provided
ARG BASE_IMAGE=ubuntu:20.04
FROM ${BASE_IMAGE}

ARG DEBIAN_FRONTEND=noninteractive
ARG USER_NAME=zephyr
ARG USER_UID=1000
ARG USER_GID=${USER_UID}
ARG WORKSPACE=/home/${USER_NAME}/zephyr_space
ARG ZEPHYR_SDK_VERSION=0.16.5
ARG ZEPHYR_SDK_ARCHIVE=zephyr-sdk-${ZEPHYR_SDK_VERSION}_linux-x86_64.tar.xz
ARG ZEPHYR_SDK_URL=https://github.com/zephyrproject-rtos/sdk-ng/releases/download/v${ZEPHYR_SDK_VERSION}/${ZEPHYR_SDK_ARCHIVE}
ARG WEST_MANIFEST=west_gitee.yml
ARG SDK_GLUE_REPO=https://gitee.com/hpmicro/zephyr_sdk_glue.git
ARG SDK_GLUE_BRANCH=main
ARG CMAKE_VERSION=3.28.3
ARG CMAKE_ARCH=linux-x86_64

ENV LANG=C.UTF-8 \
    LC_ALL=C.UTF-8

# Switch to root for package installation (needed for incremental builds)
USER root

# Install required packages (excluding cmake, will install newer version)
# Skip if packages already installed (incremental build scenario)
RUN if ! command -v git >/dev/null 2>&1 || ! command -v wget >/dev/null 2>&1; then \
        apt-get update && \
        apt-get install -y --no-install-recommends \
            ca-certificates \
            git \
            ninja-build \
            gperf \
            ccache \
            dfu-util \
            device-tree-compiler \
            wget \
            python3-dev \
            python3-pip \
            python3-setuptools \
            python3-tk \
            python3-wheel \
            python3-venv \
            xz-utils \
            file \
            make \
            gcc \
            gcc-multilib \
            g++-multilib \
            libsdl2-dev \
            libmagic1 \
            pkg-config \
            tar \
            unzip \
            bzip2 \
            locales \
            udev && \
        rm -rf /var/lib/apt/lists/*; \
    else \
        echo "Skipping package installation (already installed in base image)"; \
    fi

# Install CMake 3.20+ (download pre-built binary)
# Use CMake official download site (https://cmake.org/files/) as primary source
# GitHub releases as fallback only
# Note: Run as root to install to /opt and create symlinks
# Extract major.minor version from CMAKE_VERSION (e.g., 3.28.3 -> 3.28)
RUN CMAKE_MAJOR_MINOR=$(echo "${CMAKE_VERSION}" | cut -d. -f1,2) && \
    CMAKE_DOWNLOADED=0 && \
    for CMAKE_URL in \
        "https://cmake.org/files/v${CMAKE_MAJOR_MINOR}/cmake-${CMAKE_VERSION}-${CMAKE_ARCH}.tar.gz" \
        "https://github.com/Kitware/CMake/releases/download/v${CMAKE_VERSION}/cmake-${CMAKE_VERSION}-${CMAKE_ARCH}.tar.gz"; \
    do \
        echo "Trying to download CMake from: ${CMAKE_URL}" && \
        if wget --tries=2 --timeout=120 --progress=dot:giga ${CMAKE_URL} -O /tmp/cmake.tar.gz 2>&1 | tail -1; then \
            if [ -f /tmp/cmake.tar.gz ] && [ -s /tmp/cmake.tar.gz ]; then \
                CMAKE_DOWNLOADED=1 && \
                break; \
            fi; \
        fi; \
        echo "Failed, trying next mirror..." && \
        rm -f /tmp/cmake.tar.gz; \
    done && \
    if [ ${CMAKE_DOWNLOADED} -eq 0 ]; then \
        echo "ERROR: Failed to download CMake from all mirrors. Please check your network connection." && \
        exit 1; \
    fi && \
    echo "Successfully downloaded CMake, extracting..." && \
    tar -xzf /tmp/cmake.tar.gz -C /tmp && \
    rm -rf /opt/cmake && \
    mv /tmp/cmake-${CMAKE_VERSION}-${CMAKE_ARCH} /opt/cmake && \
    ln -sf /opt/cmake/bin/cmake /usr/local/bin/cmake && \
    ln -sf /opt/cmake/bin/ctest /usr/local/bin/ctest && \
    ln -sf /opt/cmake/bin/cpack /usr/local/bin/cpack && \
    rm -f /tmp/cmake.tar.gz && \
    echo "CMake installation completed:" && \
    cmake --version && \
    rm -rf /tmp/* /tmp/.* 2>/dev/null || true

# Install HPMicro RISC-V OpenOCD
# Download from GitHub releases and extract to /usr/local/bin
# Reference: https://github.com/hpmicro/riscv-openocd/releases/tag/hpm_xpi_v0.4.0
RUN OPENOCD_VERSION="hpm_xpi_v0.4.0" && \
    OPENOCD_URL="https://github.com/hpmicro/riscv-openocd/releases/download/${OPENOCD_VERSION}/openocd-linux-x86_64.tar.gz" && \
    echo "Downloading HPMicro OpenOCD from: ${OPENOCD_URL}" && \
    wget --tries=3 --timeout=120 --progress=dot:giga ${OPENOCD_URL} -O /tmp/openocd.tar.gz && \
    if [ ! -f /tmp/openocd.tar.gz ] || [ ! -s /tmp/openocd.tar.gz ]; then \
        echo "ERROR: Failed to download OpenOCD" && \
        exit 1; \
    fi && \
    echo "Extracting OpenOCD to /usr/local/bin..." && \
    tar -xzf /tmp/openocd.tar.gz -C /usr/local/bin --strip-components=1 2>/dev/null || \
    tar -xzf /tmp/openocd.tar.gz -C /usr/local/bin && \
    chmod +x /usr/local/bin/openocd 2>/dev/null || true && \
    find /usr/local/bin -name "openocd" -type f -exec chmod +x {} \; 2>/dev/null || true && \
    rm -f /tmp/openocd.tar.gz && \
    echo "OpenOCD installation completed:" && \
    (openocd --version 2>/dev/null || /usr/local/bin/openocd --version 2>/dev/null || echo "OpenOCD installed (version check may require device connection)")

RUN locale-gen en_US.UTF-8 && \
    update-ca-certificates
ENV LANG=en_US.UTF-8
ENV LANGUAGE=en_US:en
ENV LC_ALL=en_US.UTF-8

# Create an unprivileged user that will own the workspace (if not exists)
RUN if ! id -u ${USER_NAME} >/dev/null 2>&1; then \
        groupadd --gid ${USER_GID} ${USER_NAME} && \
        useradd --uid ${USER_UID} --gid ${USER_GID} --create-home --shell /bin/bash ${USER_NAME} && \
        mkdir -p ${WORKSPACE} && \
        chown -R ${USER_NAME}:${USER_NAME} /home/${USER_NAME}; \
    else \
        echo "User ${USER_NAME} already exists, skipping creation"; \
        mkdir -p ${WORKSPACE} && \
        chown -R ${USER_NAME}:${USER_NAME} ${WORKSPACE} 2>/dev/null || true; \
    fi

# Install west (skip if already installed)
RUN if ! command -v west >/dev/null 2>&1; then \
        pip3 install --no-cache-dir west; \
    else \
        echo "west already installed, skipping"; \
    fi

ENV HOME=/home/${USER_NAME} \
    PATH=/usr/local/bin:/home/${USER_NAME}/.local/bin:/root/.local/bin:$PATH \
    ZEPHYR_TOOLCHAIN_VARIANT=zephyr \
    ZEPHYR_SDK_INSTALL_DIR=${WORKSPACE}/zephyr-sdk-${ZEPHYR_SDK_VERSION} \
    WORKSPACE=${WORKSPACE}

USER ${USER_NAME}
WORKDIR ${WORKSPACE}

# Initialize west workspace from remote sdk_glue repository
# Skip if workspace already initialized (incremental build scenario)
RUN if [ ! -d "${WORKSPACE}/.west" ]; then \
        west init -m ${SDK_GLUE_REPO} --mr ${SDK_GLUE_BRANCH} && \
        west config manifest.file ${WEST_MANIFEST} && \
        west update && \
        west zephyr-export; \
    else \
        echo "West workspace already initialized, skipping initialization"; \
        west update || true; \
    fi

# Install Python requirements
# Try to install all requirements, but continue even if some optional packages fail
# (e.g., clang-format may fail due to network issues but is not required for building)
# Use TMPDIR to avoid /tmp space issues during pip installation
RUN rm -rf /tmp/* /tmp/.* 2>/dev/null || true && \
    TMPDIR=/var/tmp pip3 install --no-cache-dir -r zephyr/scripts/requirements.txt || \
    (echo "Warning: Some packages failed to install, installing essential packages only..." && \
     TMPDIR=/var/tmp pip3 install --no-cache-dir -r zephyr/scripts/requirements-base.txt)

# Apply HPM SDK patches (skip if already applied)
RUN if [ -f "${WORKSPACE}/sdk_glue" ] || [ -d "${WORKSPACE}/sdk_glue" ]; then \
        west supply || echo "west supply skipped or already applied"; \
    else \
        echo "sdk_glue not found, skipping west supply"; \
    fi

# Download and install Zephyr SDK (skip if already installed)
WORKDIR /tmp
RUN if [ ! -d "${ZEPHYR_SDK_INSTALL_DIR}" ]; then \
        wget -q ${ZEPHYR_SDK_URL} && \
        tar -C ${WORKSPACE} -xf ${ZEPHYR_SDK_ARCHIVE} && \
        rm ${ZEPHYR_SDK_ARCHIVE} && \
        ${ZEPHYR_SDK_INSTALL_DIR}/setup.sh -t all -h && \
        rm -rf ${ZEPHYR_SDK_INSTALL_DIR}/temp; \
    else \
        echo "Zephyr SDK already installed at ${ZEPHYR_SDK_INSTALL_DIR}, skipping installation"; \
    fi

WORKDIR ${WORKSPACE}

CMD ["/bin/bash"]

